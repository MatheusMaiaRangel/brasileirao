{
  "name": "back",
  "version": "1.0.0",
  "description": "API REST com Fastify e NeDB do Brasileirão",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./test/setup.ts --test test/*.test.ts",
    "test:coverage": "tsx --import ./test/setup.ts --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 test/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.0.0",
    "@seald-io/nedb": "^4.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
